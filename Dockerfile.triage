# SOC triage app: Streamlit UI (default) or the triage MCP server.
#
#   docker build -f Dockerfile.triage -t soc-triage .
#   docker run -p 8501:8501 -v "$PWD/.triage:/app/.triage" soc-triage                 # UI
#   docker run -p 8001:8001 -e TRIAGE_MCP_HOST=0.0.0.0 soc-triage python -m triage.mcp_server
#
# For a read-only public demo, bake a snapshot of .triage/ into the image (see docs/DEPLOY.md).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 TRIAGE_HOME=/app/.triage

COPY requirements-triage.txt .
RUN pip install --no-cache-dir -r requirements-triage.txt

COPY triage/ triage/
COPY agent/analyze.py agent/analyze.py
COPY data/excytin/ data/excytin/
COPY results/ results/

RUN useradd --create-home app && mkdir -p /app/.triage && chown -R app /app
USER app

EXPOSE 8501 8001
CMD ["streamlit", "run", "triage/ui/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
