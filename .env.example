# Copy to .env and adjust if you want non-default credentials.
# docker-compose.yml falls back to the values baked in below if no .env
# is present, so `docker compose up` works out of the box -- these are
# placeholder credentials for a local, synthetic benchmark database only,
# not real secrets.

POSTGRES_USER=secinvest
POSTGRES_PASSWORD=secinvest_local_only
POSTGRES_DB=secinvest

# ── Triage agent (triage/) ────────────────────────────────────────────
# Model: ollama (default, free) | lmstudio (free) | openai (paid, capped by TRIAGE_BUDGET_USD)
TRIAGE_PROVIDER=ollama
TRIAGE_MODEL=gpt-oss:20b
# TRIAGE_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
TRIAGE_BUDGET_USD=5
# Response cache: readwrite | record | replay | off
TRIAGE_CACHE=readwrite

# ExCyTIn MySQL (docker-compose.excytin.yml); the agent uses the read-only "reader" user
EXCYTIN_DATA=~/excytin-data/data_anonymized/incidents
EXCYTIN_PORT=3316

# Optional threat-intel keys (free accounts)
# ABUSEIPDB_API_KEY=
# ABUSECH_AUTH_KEY=
# NVD_API_KEY=

# Optional tracing
# TRIAGE_TRACE_FILE=traces.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=
