# Copy to .env before running agent.py or benchmark.py from this directory.

OPENAI_API_KEY=sk-your-key-here

# Any OpenAI model that supports tool calling. Defaults to gpt-4o if unset.
OPENAI_MODEL=gpt-4o

# Where the MCP server (see ../mcp_server.py) is reachable. Defaults to
# http://localhost:8000/mcp if unset -- matches `docker compose up` at the
# repo root with no port remapping.
MCP_SERVER_URL=http://localhost:8000/mcp
